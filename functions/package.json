{
  "name": "@walkin/functions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --sourcemap --outfile=dist/index.js --external:firebase-admin --external:firebase-admin/* --external:firebase-functions --external:firebase-functions/* --external:luxon --external:zod",
    "build:test": "esbuild src/test/*.test.ts --bundle --platform=node --target=node22 --format=esm --outdir=dist/test --external:luxon --external:firebase-admin --external:firebase-admin/* --external:firebase-functions --external:firebase-functions/* --external:zod --external:node:*",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build:test && node --test dist/test/*.test.js",
    "serve": "firebase emulators:start --project demo-walkin --only functions,firestore,auth,storage,pubsub"
  },
  "dependencies": {
    "firebase-admin": "^13.2.0",
    "firebase-functions": "^6.3.2",
    "luxon": "^3.6.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.13.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": "22"
  }
}
