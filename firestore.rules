rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ---------- Helpers ----------
    function signedIn() {
      return request.auth != null;
    }

    function token() {
      return signedIn() ? request.auth.token : {};
    }

    function isAdmin() {
      return signedIn() && token().role == 'admin';
    }

    function isProviderStaff(providerId) {
      return signedIn()
        && token().providerId == providerId
        && token().role in ['owner', 'staff', 'admin'];
    }

    function providerPath(providerId) {
      return /databases/$(database)/documents/providers/$(providerId);
    }

    function providerPublished(providerId) {
      return exists(providerPath(providerId))
        && get(providerPath(providerId)).data.status == 'published';
    }

    function canReadProviderData(providerId) {
      return providerPublished(providerId) || isProviderStaff(providerId) || isAdmin();
    }

    // ---------- Users ----------
    // Clients may manage only their own profile. Claims and roles are set by
    // Cloud Functions via the Admin SDK and are never client-writable.
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'phone', 'photoURL',
          'fcmTokens', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == userId;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'phone', 'photoURL',
          'fcmTokens', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      match /{subcollection}/{docId} {
        allow read, write: if false;
      }
    }

    // ---------- Providers and their public configuration ----------
    match /providers/{providerId} {
      allow read: if canReadProviderData(providerId);
      allow write: if false; // Cloud Functions only

      match /services/{serviceId} {
        allow read: if canReadProviderData(providerId);
        allow write: if false;
      }

      match /staff/{staffId} {
        allow read: if isProviderStaff(providerId) || isAdmin();
        allow write: if false;
      }

      match /availability/{ruleId} {
        allow read: if canReadProviderData(providerId);
        allow write: if false;
      }

      match /slotLocks/{lockId} {
        allow read, write: if false;
      }
    }

    // ---------- Bookings ----------
    // Reads are allowed for the customer and provider staff. All writes go
    // through Cloud Functions so availability checks are authoritative.
    match /bookings/{bookingId} {
      allow read: if signedIn()
        && (resource.data.customerId == request.auth.uid
          || isProviderStaff(resource.data.providerId)
          || isAdmin());
      allow write: if false;
    }

    // ---------- Backend-only collections ----------
    match /idempotencyKeys/{key} {
      allow read, write: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
