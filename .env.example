# Firebase CLI / deployment (root)
# Copy to .env and fill in from the existing Firebase project.
FIREBASE_PROJECT_ID=walkin-123
FIREBASE_REGION=us-central1
FIREBASE_APP_CHECK_DEBUG_TOKEN=

# Monitoring setup (npm run monitoring:setup)
ALERT_EMAIL=
# Optional: existing notification channel resource name; overrides ALERT_EMAIL channel creation.
MONITORING_NOTIFICATION_CHANNEL=
