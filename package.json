{
  "name": "walkin",
  "version": "0.1.0",
  "private": true,
  "description": "WalkIn booking platform — one Firebase backend, Next.js web/dashboard, Flutter mobile",
  "workspaces": [
    "apps/web",
    "apps/web-v2",
    "functions",
    "packages/shared"
  ],
  "scripts": {
    "build": "npm run build -w @walkin/shared && npm run build -w @walkin/functions && npm run build -w @walkin/web",
    "build:backend": "npm run build -w @walkin/shared && npm run build -w @walkin/functions",
    "dev:web": "npm run dev -w @walkin/web",
    "deploy:web": "firebase deploy --only apphosting:walkin-web --project walkin-123",
    "emulators": "firebase emulators:start --project demo-walkin",
    "emulators:test": "node scripts/emulator/start.mjs",
    "emulator:seed": "node scripts/emulator/seed.mjs",
    "test:emulator": "node --test --test-concurrency=1 \"scripts/emulator/*.test.mjs\" \"scripts/rules/*.test.mjs\"",
    "test:rules": "node --test \"scripts/rules/*.test.mjs\"",
    "test:mobile:integration": "flutter test integration_test",
    "emulators:stop": "firebase emulators:exec --project demo-walkin --only firestore,functions,auth,storage,pubsub -- \"echo stopped\"",
    "test": "npm run test -w @walkin/shared && npm run test -w @walkin/functions",
    "typecheck": "npm run build -w @walkin/shared && npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "schema:generate": "npm run schema:generate -w @walkin/shared",
    "schema:check": "npm run schema:check -w @walkin/shared",
    "monitoring:setup": "node scripts/monitoring/setup-alerts.mjs",
    "dev:web-v2": "npm run dev -w @walkin/web-v2",
    "emulator:seed:campus": "node scripts/emulator/seed-campus.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@dataconnect/generated": "file:src/dataconnect-generated"
  }
}
